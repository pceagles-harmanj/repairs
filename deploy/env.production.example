# ---------------------------------------------------------------------------
# Production .env for repairs.internal.pceagles.org (LAN only, plain http)
# Copy to /opt/repairs/.env and fill in the blanks.
# ---------------------------------------------------------------------------

# ---- tech app ----
PORT=8080
HOST=0.0.0.0
PUBLIC_URL=http://repairs.internal.pceagles.org:8080
DB_PATH=/app/data/repairs.db

# Set this. Anyone who can reach port 8080 can otherwise use the app.
APP_PASSWORD=
# Leave blank: a random secret is generated and stored in the database.
SESSION_SECRET=

# TLS. Leave both blank for plain http; set both and Node serves https directly
# (no nginx or Caddy needed). deploy/tls-letsencrypt.sh writes these files.
TLS_CERT_PATH=
TLS_KEY_PATH=
# Optional: a plain-http port that answers ONLY with a 302 to https. Set this
# when you turn TLS on, so links already sitting in inboxes keep working. It
# must differ from PORT, and it is ignored unless a certificate is configured.
TLS_REDIRECT_HTTP_PORT=

# ---- Google ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Cloud console entry exactly, including the port.
OAUTH_REDIRECT_URI=http://repairs.internal.pceagles.org:8080/oauth2/callback

# ---- student status site (LAN only for now) ----
PUBLIC_SITE_ENABLED=true
PUBLIC_SITE_PORT=8081
PUBLIC_SITE_HOST=0.0.0.0
# Port 80: no port in the URL. Whatever this says, Google's redirect URI must
# match it exactly, plus /auth/google/callback.
PUBLIC_SITE_URL=http://repairs.internal.pceagles.org

# Certificates for the student site. Falls back to TLS_CERT_PATH/TLS_KEY_PATH
# when blank, which is what you want with one certificate for one hostname.
PUBLIC_TLS_CERT_PATH=
PUBLIC_TLS_KEY_PATH=
# Every magic link ever emailed points at this site, so this one matters most:
# the old http:// links land here and get bounced to https.
PUBLIC_TLS_REDIRECT_HTTP_PORT=
# Student sign-in uses the redirect flow. These default to the tech app's OAuth
# client, so leave them blank unless you want a separate one.
PUBLIC_OAUTH_CLIENT_ID=
PUBLIC_OAUTH_CLIENT_SECRET=
# Blank = PUBLIC_SITE_URL + /auth/google/callback. This exact string must be an
# Authorized redirect URI on the OAuth client:
#   http://repairs.internal.pceagles.org/auth/google/callback
PUBLIC_OAUTH_REDIRECT_URI=
# Deprecated alias for PUBLIC_OAUTH_CLIENT_ID.
PUBLIC_GOOGLE_CLIENT_ID=
PUBLIC_ALLOWED_DOMAINS=pceagles.org
PUBLIC_ALLOW_LOOKUP=true
PUBLIC_TRUST_PROXY=false
PUBLIC_LINK_SECRET=

# ---- branding ----
ORG_NAME=Pella Christian Schools
HELPDESK_NAME=Technology Department
HELPDESK_SIGNATURE=Technology Department
BRAND_PRIMARY=#8A1538
BRAND_ACCENT=#ECAE12

# ---- behaviour ----
DRY_RUN_EMAIL=true          # flip to false once you have watched a few emails
ALLOW_DEVICE_WRITEBACK=true
WRITE_REPAIR_NOTE_ON_CLOSE=true
DEVICE_CACHE_TTL_MINUTES=720

# ---- loaners ----
LOANER_ORG_UNIT=/Devices/Loaners
LOANER_DUE_SCHOOL_DAYS=5
SCHOOL_HOLIDAYS=
LOANER_REMINDERS_ENABLED=true
LOANER_REMINDER_HOUR=8
LOANER_DIGEST_TO=

# ---- parcel tracking (AfterShip) ----
# multi = read the tracking number, work out the carrier, call that carrier's
# own API. UPS, FedEx and USPS all give tracking away free, so this costs
# nothing. Set only the carriers you actually order from; the rest are skipped.
TRACKING_PROVIDER=multi

# ---- UPS (free) ----  developer.ups.com -> create an app
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_ENV=production

# ---- FedEx (free) ----  developer.fedex.com -> create a project
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ENV=production

# ---- USPS (free with a business account) ----  developers.usps.com
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=
# Only touch these if USPS moves the API again:
# USPS_API_BASE=https://apis.usps.com
# USPS_TRACK_PATH=/tracking/v3/tracking/{tracking}?expand=DETAIL

# ---- Amazon ----
# There is nothing to configure. Amazon Logistics (TBA... numbers) has no public
# tracking API - the Amazon Shipping API is for merchants who ship WITH Amazon,
# not for customers tracking what they bought. Those shipments stay manual, and
# the app says so instead of logging an error every three hours.
#
# Worth knowing: Amazon often hands parcels to UPS, FedEx or USPS. When it does,
# paste THAT carrier's number and it tracks automatically - the number's format
# decides, whatever the vendor is called.

# ---- AfterShip (paid, every carrier) ----
# Only worth it if parcels arrive on carriers the three above do not cover.
# Set TRACKING_PROVIDER=aftership and TRACKING_API_KEY to use it.
TRACKING_API_KEY=
TRACKING_POLL_MINUTES=180
TRACKING_HOUR_FROM=6
TRACKING_HOUR_TO=21

# ---- nightly backup to the NAS ----
BACKUP_ENABLED=true
# /backups inside the container is the host's /mnt/nas-repairs
BACKUP_DIR=/backups
BACKUP_HOUR=1
BACKUP_KEEP_DAYS=30
BACKUP_GZIP=true
# The DB lives on the container's own disk and the backup on the NAS, so this
# check stays meaningful - leave it false.
BACKUP_ALLOW_SAME_DISK=false
# Optional but recommended: the name of a file that exists ONLY on the NAS share,
# so the app can tell "share mounted" from "share gone" with certainty. Create it
# once on the NAS itself:  touch /volume1/backups/repairs/.repairs-nas
BACKUP_MARKER_FILE=.repairs-nas
# SQLite stages the backup locally, then copies the finished file to the share.
# Blank = beside the database in /app/data.
BACKUP_STAGING_DIR=
