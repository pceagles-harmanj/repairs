# ============================ Tech app (internal) ============================
PORT=8080
HOST=0.0.0.0
# How staff reach the app. With internal DNS + a cert this is your https name.
PUBLIC_URL=https://repairs.internal.pceagles.org
DB_PATH=./data/repairs.db

# Shared password for the tech UI. Leave blank only on a laptop-only install.
APP_PASSWORD=
# Blank is fine: a random secret is generated and stored in the database.
SESSION_SECRET=

# Serve HTTPS directly from Node (no nginx needed). Both must be set to take effect.
# Google requires https for any redirect URI that is not localhost.
TLS_CERT_PATH=
TLS_KEY_PATH=

# ============================ Google Workspace ===============================
# Google Cloud Console -> Credentials -> OAuth client ID -> Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where Google sends the admin back after consent. Defaults to PUBLIC_URL +
# /oauth2/callback. Set it separately when the app is served over plain http:
# Google accepts https://<your name>/oauth2/callback, or http://localhost:PORT/...
# (connect once through `ssh -L 8080:localhost:8080 server` and you are done).
OAUTH_REDIRECT_URI=

# ============================ Public status site =============================
# Runs on its own port so only these pages can be exposed off-network.
PUBLIC_SITE_ENABLED=true
PUBLIC_SITE_PORT=8081
PUBLIC_SITE_HOST=0.0.0.0
# The address users see (what you port-forward / proxy to PUBLIC_SITE_PORT).
# Required for status + unsubscribe links to appear in emails.
PUBLIC_SITE_URL=https://repairs.pceagles.org
# Google sign-in on the public page. Usually the same client as above, with the
# public origin added under "Authorized JavaScript origins". Blank hides the button.
PUBLIC_GOOGLE_CLIENT_ID=
# Only allow sign-ins from these domains (comma separated).
PUBLIC_ALLOWED_DOMAINS=pceagles.org
# Allow the "asset tag + email" form as a fallback for users without the email.
PUBLIC_ALLOW_LOOKUP=true
# Only turn this on if a reverse proxy YOU control sits in front of the public
# port; it makes the rate limiter trust X-Forwarded-For.
PUBLIC_TRUST_PROXY=false
# Who may embed the public pages in an iframe (for a Google Sites page).
PUBLIC_FRAME_ANCESTORS='self' https://sites.google.com https://*.googleusercontent.com
# Separate cert for the public hostname, if different from the internal one.
PUBLIC_TLS_CERT_PATH=
PUBLIC_TLS_KEY_PATH=
# Signs the magic links. Blank = generated and stored in the database.
# Changing this invalidates every link already emailed.
PUBLIC_LINK_SECRET=

# ============================ School branding ================================
# Sampled from pceagles.org. One change here re-themes every email (even ones
# already saved in the database), the public site, and the tech UI header.
BRAND_PRIMARY=#8A1538
BRAND_PRIMARY_DARK=#6E1029
BRAND_ACCENT=#ECAE12
BRAND_INK=#10181F
BRAND_MUTED=#5B6770
BRAND_WASH=#F1F1F1
BRAND_BORDER=#E6E4E1

# ============================ Loaner pool ====================================
# Devices in this Google org unit (or below it) count as loaners.
LOANER_ORG_UNIT=/Devices/Loaners
# Used to expand what a tech types or scans: "12" -> "Loaner-012".
LOANER_TAG_PREFIX=Loaner-
LOANER_TAG_PAD=3

# ============================ Loaner due dates & reminders ===================
# Working days a loaner is out for by default (weekends/holidays skipped).
LOANER_DUE_SCHOOL_DAYS=5
# Which weekdays count as school days: 1 = Monday ... 7 = Sunday.
LOANER_SCHOOL_WEEKDAYS=1,2,3,4,5
# No school on these days. Single dates or ranges, comma separated.
# e.g. 2026-11-25..2026-11-27,2026-12-21..2027-01-02,2027-03-15..2027-03-19
SCHOOL_HOLIDAYS=
# Students get an email the day before and the day it is due.
LOANER_REMINDERS_ENABLED=true
# Local time the daily reminder pass runs.
LOANER_REMINDER_HOUR=8
LOANER_REMINDER_MINUTE=0
# Once overdue, nudge again every N days, at most this many times.
LOANER_OVERDUE_EVERY_DAYS=3
LOANER_MAX_OVERDUE_NUDGES=3
# Daily list of overdue / due-today loaners for the helpdesk.
LOANER_DIGEST_ENABLED=true
# Blank = whichever Google account is connected.
LOANER_DIGEST_TO=

# ============================ Repair note write-back =========================
# Closing a ticket appends one line to the repaired device's notes in Google
# Admin: "2026-08-31 Ticket #142: Cracked screen - replaced LCD (jacob)".
WRITE_REPAIR_NOTE_ON_CLOSE=true
# Google's notes field is finite; when full, the OLDEST lines are dropped.
DEVICE_NOTES_MAX_CHARS=500

# ============================ Behavior =======================================
ORG_NAME=Prairie Central
HELPDESK_NAME=Technology Department
HELPDESK_SIGNATURE=Technology Department
DEVICE_CACHE_TTL_MINUTES=720
DRY_RUN_EMAIL=false
ALLOW_DEVICE_WRITEBACK=true

# ============================ Parcel tracking ================================
# Automatic shipment status from the carrier. aftership | mock | none.
# Blank key = tracking is off and statuses stay manual.
TRACKING_PROVIDER=aftership
TRACKING_API_KEY=
# Override only if your account's docs show a different API version/host.
TRACKING_API_BASE=https://api.aftership.com/v4
# How often an open shipment is re-checked, and the window it happens in.
# Nobody needs carrier scans at 3am, and a free plan has a monthly quota.
TRACKING_POLL_MINUTES=180
TRACKING_HOUR_FROM=6
TRACKING_HOUR_TO=21
TRACKING_MAX_PER_RUN=25

# ============================ Nightly backup ================================
BACKUP_ENABLED=true
# Point this at the NAS share as it is mounted on this machine.
# macOS SMB mount example: /Volumes/backups/repairs
BACKUP_DIR=
BACKUP_HOUR=1
BACKUP_MINUTE=0
BACKUP_KEEP_DAYS=30
BACKUP_GZIP=true
# Safety check: refuse to write "backups" onto the same disk as the database,
# which is what happens when the NAS share is not mounted. Only set this true if
# you deliberately want a local copy.
BACKUP_ALLOW_SAME_DISK=false
