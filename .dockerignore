# Keep the build context small, and - more importantly - keep the host's own
# files out of the image. Copying a macOS node_modules over the Linux one built
# in the builder stage produces "invalid ELF header" at runtime, which is a
# baffling error to debug at 5pm.
node_modules
**/node_modules

# The live database and its WAL: the container gets these from a bind mount.
data
*.db
*.db-shm
*.db-wal

# Secrets come from env_file at runtime, never baked into an image.
.env
.env.*
!.env.example

.git
.gitignore
.DS_Store
*.log
npm-debug.log*
coverage
.vscode
.idea
